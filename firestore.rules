rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    match /adminAccess/{path=**} { allow read, write: if false; }
    match /adminAudit/{path=**} { allow read, write: if false; }
    match /adminMail/{path=**} { allow read, write: if false; }
    match /emailLog/{path=**} { allow read, write: if false; }
    match /users/{uid} {
      allow read: if owns(uid) || admin();
      allow delete: if false;
      allow create, update: if owns(uid)
        && request.resource.data.get('usage', {}).get('tier', 'free') == (resource == null ? 'free' : resource.data.get('usage', {}).get('tier', 'free'))
        && request.resource.data.get('stripeCustomerId', '') == (resource == null ? '' : resource.data.get('stripeCustomerId', ''))
        && request.resource.data.get('stripeSubscriptionId', '') == (resource == null ? '' : resource.data.get('stripeSubscriptionId', ''))
        && request.resource.data.get('billing', {}) == (resource == null ? {} : resource.data.get('billing', {}));
      match /{collection}/{path=**} {
        allow read: if owns(uid) || admin();
        allow write: if owns(uid) && collection != 'billingEvents';
      }
    }
    match /chats/{chatId} {
      allow read: if admin() || owns(resource.data.userId);
      allow create: if owns(request.resource.data.userId);
      allow update: if owns(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if owns(resource.data.userId);
      match /{collection}/{path=**} {
        allow read: if admin() || owns(get(/databases/$(database)/documents/chats/$(chatId)).data.userId);
        allow write: if owns(get(/databases/$(database)/documents/chats/$(chatId)).data.userId);
      }
    }
    match /satisfactionSignals/{id} {
      allow read: if admin();
      allow create: if request.resource.data.get('userId', null) == null || owns(request.resource.data.userId);
      allow update: if owns(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }
    match /funnelEvents/{id} {
      allow read: if admin();
      allow create: if true;
      allow update, delete: if false;
    }
    // Existing unrelated collections retain their current behavior. Audit them
    // independently before widening this rollout to a full database lockdown.
    match /{collection}/{path=**} {
      allow read, write: if !(collection in ['users', 'chats', 'satisfactionSignals', 'funnelEvents', 'emailLog', 'adminAccess', 'adminAudit', 'adminMail']);
    }
  }
}
