rules_version = '2';

// ⚠️ TRANSITIONAL RULES — matches the previous fully-open behavior everywhere
// EXCEPT billing integrity on users/{uid}. The database is still publicly
// readable/writable otherwise; a real per-user lockdown is planned post-launch.
//
// Billing invariant: usage.tier, stripeCustomerId, stripeSubscriptionId and
// the whole `billing` map (proSince / proEndedAt / status / ...) can only be
// changed by the backend Stripe webhook (Admin SDK bypasses these rules).
// Clients may still freely write usage.count / usage.windowStart — the quota
// bookkeeping — as long as the billing fields stay untouched.
// The billingEvents subcollection is the immutable revenue log: readable, but
// client writes are refused so the timeline can't be forged or erased.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      // No client deletes: deleting the doc would erase the tier record.
      allow delete: if false;
      // Writes allowed only if billing fields end up unchanged.
      // (request.resource.data is the post-merge state of the document.)
      allow create, update: if
        request.resource.data.get('usage', {}).get('tier', 'free')
          == (resource == null ? 'free' : resource.data.get('usage', {}).get('tier', 'free'))
        && request.resource.data.get('stripeCustomerId', '')
          == (resource == null ? '' : resource.data.get('stripeCustomerId', ''))
        && request.resource.data.get('stripeSubscriptionId', '')
          == (resource == null ? '' : resource.data.get('stripeSubscriptionId', ''))
        // Map equality covers every key inside `billing` in one clause, so
        // fields added to it later are protected without touching this rule.
        && request.resource.data.get('billing', {})
          == (resource == null ? {} : resource.data.get('billing', {}));

      // Subcollections (users/{uid}/exams, ...) keep the old open behavior.
      // NOTE: in rules v2 a bare {sub=**} matches ZERO or more segments and
      // would therefore ALSO match the user document itself, reopening the
      // billing fields — so this is anchored one level down on purpose.
      // NOTE: rules OR together, so a narrower match below cannot take write
      // access AWAY from an open rule. billingEvents has to be excluded here.
      match /{subcollection}/{subdoc=**} {
        allow read: if true;
        allow write: if subcollection != 'billingEvents';
      }
    }

    // Conversion funnel log. Append-only for the same reason billingEvents is:
    // it is evidence. A funnel a client can rewrite cannot be used to decide
    // where the paywall goes, which is the only thing it is collected for.
    // Rows are written unauthenticated-tolerant (a logged-out landing-page
    // upload is a real step), so create stays open; edits and deletes do not.
    match /funnelEvents/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Outbound email log. BACKEND ONLY — no client read, no client write.
    //
    // Two separate reasons, and either alone would be enough:
    //
    //   1. Every row carries a recipient's email address. Left under the open
    //      catch-all below, the whole mailing list — 2,079 addresses — is
    //      readable by anyone who can reach the project, with no login.
    //
    //   2. The document id IS the idempotency lock. email_sender writes the
    //      row as the lock, and _already_sent treats a row with
    //      status == 'sent' as proof a message has gone out. A client that can
    //      write here can forge 'sent' rows to silently suppress a campaign,
    //      or delete real ones to make the next run mail the same students a
    //      second time. The guard against duplicate sends cannot live in a
    //      collection the recipients can edit.
    //
    // The Admin SDK bypasses these rules, so the backend is unaffected.
    match /emailLog/{logId} {
      allow read, write: if false;
    }

    // Every other collection: unchanged (open) — deliberately identical to
    // the previous rules so nothing else changes behavior.
    // NOTE: rules OR together, so this open rule would hand read and write
    // access back to funnelEvents and emailLog unless both are excluded HERE.
    // The narrower `allow ... if false` above does not take access away — it
    // only documents the intent. This exclusion list is what enforces it.
    match /{collection}/{docPath=**} {
      allow read, write: if collection != 'users'
        && collection != 'funnelEvents'
        && collection != 'emailLog';
    }
  }
}
